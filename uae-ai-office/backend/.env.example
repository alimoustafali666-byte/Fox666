APP_ENV=development
APP_NAME=UAE AI Office API
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql+psycopg://uae_app:uae_app@localhost:5432/uae_ai_office

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-generate-a-real-secret-for-local-dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

REFRESH_COOKIE_NAME=refresh_token
# false for local http:// development only -- must stay true in production
COOKIE_SECURE=false

LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Object storage (S3-compatible: AWS S3, MinIO, etc.). Nothing in the app
# constructs a storage provider yet (Step 8 is the first caller), so these
# are unused until then -- "fake" needs none of the fields below and is
# what the automated test suite uses.
STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=me-central-1
# STORAGE_BUCKET=uae-ai-office-documents
# STORAGE_ACCESS_KEY_ID=change-me
# STORAGE_SECRET_ACCESS_KEY=change-me
STORAGE_USE_SSL=true
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_SIGNED_URL_TTL_SECONDS=3600

# Embeddings + retrieval (Step 10). Nothing constructs an embedding
# provider until a document is actually indexed or searched, so these
# are unused until then -- "fake" needs no API key and is what the
# automated test suite uses. EMBEDDING_DIMENSION must match
# app.modules.documents.models.EMBEDDING_VECTOR_DIMENSION (the fixed
# pgvector column width from migration 0012) -- changing it requires a
# new migration, not just this value.
EMBEDDING_PROVIDER=voyage
# EMBEDDING_API_KEY=change-me
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

RETRIEVAL_TOP_K_DEFAULT=12
RETRIEVAL_TOP_K_MAX=20
# Conservative starting point (cosine similarity) -- not yet calibrated
# against real pilot data; see the Step 10 report.
RETRIEVAL_SIMILARITY_THRESHOLD=0.3

# Ask Your Business (Step 11). Nothing constructs an LLM provider until a
# question is actually asked, so these are unused until then -- "fake"
# needs no API key and is what the automated test suite uses. Sonnet-tier
# per the approved design; see the Step 11 report for the disclosure that
# this exact model identifier has not been verified against a live API
# call in this environment (same caveat as EMBEDDING_MODEL/voyage-3).
LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=change-me
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_OUTPUT_TOKENS=1024
CLAUDE_TIMEOUT_SECONDS=30
CLAUDE_MAX_RETRIES=2

ASK_MAX_QUESTION_LENGTH=2000
ASK_MAX_HISTORY_TURNS=2
ASK_MAX_CITATION_RETRIES=1

# Daily Management Brief (Step 12, on-demand only -- no scheduler/cron/
# background worker in this step). Reuses ANTHROPIC_API_KEY/CLAUDE_MODEL/
# CLAUDE_TIMEOUT_SECONDS/CLAUDE_MAX_RETRIES above; only the output-token
# budget is brief-specific.
BRIEF_MAX_DOCUMENTS_PER_RUN=20
BRIEF_MAX_CHARS_PER_DOCUMENT=3000
BRIEF_LOOKBACK_BRIEFS=3
BRIEF_MAX_CARRY_FORWARD_ITEMS=20
BRIEF_MAX_OUTPUT_TOKENS=2048
BRIEF_MAX_CITATION_RETRIES=1

# Evaluation harness only (Step 11.5, `python -m evaluation.run`) -- never
# read by the running app. Reuses ANTHROPIC_API_KEY/EMBEDDING_API_KEY above
# to decide LIVE vs BLOCKED_BY_CREDENTIALS; these three are cost-projection
# pricing overrides only, since provider pricing changes over time and is
# never hardcoded -- see evaluation/pricing.py.
# EVAL_CLAUDE_INPUT_PRICE_PER_1M=3.00
# EVAL_CLAUDE_OUTPUT_PRICE_PER_1M=15.00
# EVAL_VOYAGE_PRICE_PER_1M_TOKENS=change-me

