APP_ENV=development
APP_NAME=UAE AI Office API
LOG_LEVEL=info
# One origin, or a comma-separated list. CORS matches the browser's
# Origin header exactly, so every origin the frontend is actually served
# from must be listed -- e.g. a forwarded/public URL *and* localhost:
# FRONTEND_ORIGIN=https://your-app-3000.example.dev,http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# A managed provider's plain `postgresql://` DSN is accepted and is
# rewritten to the psycopg3 driver automatically (see
# app/core/config.py); pasting one verbatim is fine.
DATABASE_URL=postgresql+psycopg://uae_app:uae_app@localhost:5432/uae_ai_office

# --- Managed Postgres with a connection pooler (Neon, Supabase, RDS Proxy)
#
# Two endpoints, two jobs. Set DATABASE_URL to the POOLED endpoint and
# DATABASE_DIRECT_URL to the DIRECT (unpooled) one. On Neon the two
# hostnames differ only by a "-pooler" suffix:
#
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt&channel_binding=require
#   DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt&channel_binding=require
#
# DATABASE_URL (pooled) serves request traffic: each request opens a
# short-lived connection, and the pooler is what stops that exhausting
# the server's backend slots.
#
# DATABASE_DIRECT_URL (unpooled) is used by Alembic and nothing else.
# Transaction-mode pooling does not guarantee session continuity between
# statements, and migrations depend on exactly that (advisory locks,
# SET LOCAL, long transactional DDL). Leaving it unset is supported --
# migrations then reuse DATABASE_URL, which is right for a plain
# single-endpoint Postgres with no pooler.
#
# TLS: prefer sslmode=verify-full. It is the only mode that authenticates
# the server (verify-ca checks the chain but not the hostname; require
# encrypts but verifies nothing, so it does not stop an active MITM).
#
# sslrootcert must name a real CA bundle FILE. The value `system` works
# under the psql shipped with your OS but NOT under the libpq bundled in
# the psycopg[binary] wheel this project uses -- there it fails with
# "certificate verify failed". Give the path explicitly:
#   Debian/Ubuntu  /etc/ssl/certs/ca-certificates.crt
#   RHEL/Fedora    /etc/pki/tls/certs/ca-bundle.crt
#   Alpine         /etc/ssl/cert.pem
#   macOS/Homebrew $(brew --prefix)/etc/ca-certificates/cert.pem
#
# channel_binding=require pins the authenticated TLS channel to the SCRAM
# exchange, so a proxy that terminates TLS cannot replay the auth.
# DATABASE_DIRECT_URL=

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-generate-a-real-secret-for-local-dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

REFRESH_COOKIE_NAME=refresh_token
# Must stay true for any browser-based HTTPS flow using SameSite=None.
COOKIE_SECURE=true
# "lax" when the browser reaches the frontend and the API on the same
# site (e.g. localhost:3000 -> localhost:8000). When they are on
# different hostnames -- a forwarded-port setup where each port gets its
# own subdomain, or an api.example.com / app.example.com split -- the
# refresh cookie is cross-site and MUST be "none", which browsers only
# honour together with COOKIE_SECURE=true (so both must be set).
COOKIE_SAMESITE=none

LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Object storage (S3-compatible: AWS S3, MinIO, etc.). Nothing in the app
# constructs a storage provider yet (Step 8 is the first caller), so these
# are unused until then -- "fake" needs none of the fields below and is
# what the automated test suite uses.
STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=me-central-1
# STORAGE_BUCKET=uae-ai-office-documents
# STORAGE_ACCESS_KEY_ID=change-me
# STORAGE_SECRET_ACCESS_KEY=change-me
STORAGE_USE_SSL=true
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_SIGNED_URL_TTL_SECONDS=3600

# Embeddings + retrieval (Step 10). Nothing constructs an embedding
# provider until a document is actually indexed or searched, so these
# are unused until then -- "fake" needs no API key and is what the
# automated test suite uses. EMBEDDING_DIMENSION must match
# app.modules.documents.models.EMBEDDING_VECTOR_DIMENSION (the fixed
# pgvector column width from migration 0012) -- changing it requires a
# new migration, not just this value.
EMBEDDING_PROVIDER=voyage
# EMBEDDING_API_KEY=change-me
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

RETRIEVAL_TOP_K_DEFAULT=12
RETRIEVAL_TOP_K_MAX=20
# Conservative starting point (cosine similarity) -- not yet calibrated
# against real pilot data; see the Step 10 report.
RETRIEVAL_SIMILARITY_THRESHOLD=0.3

# Ask Your Business (Step 11). Nothing constructs an LLM provider until a
# question is actually asked, so these are unused until then -- "fake"
# needs no API key and is what the automated test suite uses. Sonnet-tier
# per the approved design; see the Step 11 report for the disclosure that
# this exact model identifier has not been verified against a live API
# call in this environment (same caveat as EMBEDDING_MODEL/voyage-3).
LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=change-me
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_OUTPUT_TOKENS=1024
CLAUDE_TIMEOUT_SECONDS=30
CLAUDE_MAX_RETRIES=2

ASK_MAX_QUESTION_LENGTH=2000
ASK_MAX_HISTORY_TURNS=2
ASK_MAX_CITATION_RETRIES=1

# Daily Management Brief (Step 12, on-demand only -- no scheduler/cron/
# background worker in this step). Reuses ANTHROPIC_API_KEY/CLAUDE_MODEL/
# CLAUDE_TIMEOUT_SECONDS/CLAUDE_MAX_RETRIES above; only the output-token
# budget is brief-specific.
BRIEF_MAX_DOCUMENTS_PER_RUN=20
BRIEF_MAX_CHARS_PER_DOCUMENT=3000
BRIEF_LOOKBACK_BRIEFS=3
BRIEF_MAX_CARRY_FORWARD_ITEMS=20
BRIEF_MAX_OUTPUT_TOKENS=2048
BRIEF_MAX_CITATION_RETRIES=1

# Evaluation harness only (Step 11.5, `python -m evaluation.run`) -- never
# read by the running app. Reuses ANTHROPIC_API_KEY/EMBEDDING_API_KEY above
# to decide LIVE vs BLOCKED_BY_CREDENTIALS; these three are cost-projection
# pricing overrides only, since provider pricing changes over time and is
# never hardcoded -- see evaluation/pricing.py.
# EVAL_CLAUDE_INPUT_PRICE_PER_1M=3.00
# EVAL_CLAUDE_OUTPUT_PRICE_PER_1M=15.00
# EVAL_VOYAGE_PRICE_PER_1M_TOKENS=change-me


# ---------------------------------------------------------------------
# Transactional email -- REQUIRED for team invitations to be delivered.
#
# Unlike STORAGE_PROVIDER / LLM_PROVIDER there is NO default and there is
# no "fake" option: a mailer that silently accepts and drops messages is
# indistinguishable from a working one in the UI, which is exactly the
# failure mode this configuration exists to prevent.
#
# Leaving EMAIL_PROVIDER unset does NOT disable team invitations. The
# invitation is still created and the API still returns a working
# invite_url for an owner/admin to share by hand; what changes is that
# the response reports email_delivery.status = "not_configured" and the
# UI says so in as many words. Nothing anywhere reports an invitation as
# emailed unless a provider actually accepted the message ("sent").
# Setting the variables below switches the same flow over to real email
# with no client change.
#
# EMAIL_PROVIDER=resend  -> Resend's HTTPS API (recommended: no SMTP
#                           ports needed, and it returns a message id
#                           you can look up in the Resend dashboard)
# EMAIL_PROVIDER=smtp    -> any SMTP relay (Amazon SES, SendGrid,
#                           Mailgun, Postmark, Microsoft 365, ...)
# EMAIL_PROVIDER=

# The From address. It MUST be on a domain the provider has verified for
# your account, or the provider rejects the send (reported as a failure,
# never as a delivered invitation).
# EMAIL_FROM_ADDRESS=no-reply@your-verified-domain.example
EMAIL_FROM_NAME=UAE AI Office
# EMAIL_REPLY_TO=support@your-verified-domain.example
EMAIL_TIMEOUT_SECONDS=20

# --- EMAIL_PROVIDER=resend
# RESEND_API_KEY=change-me

# --- EMAIL_PROVIDER=smtp
# Port 587 = STARTTLS (the default). Port 465 = implicit TLS: set
# SMTP_USE_SSL=true and SMTP_USE_STARTTLS=false.
# SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
# SMTP_USERNAME=change-me
# SMTP_PASSWORD=change-me
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false

# The publicly reachable base URL of the frontend. Invitation links are
# built from this, so a localhost value produces a link that cannot work
# from a recipient's inbox. Left unset it is resolved automatically (a
# Codespaces forwarded URL, else the first non-loopback FRONTEND_ORIGIN);
# always set it explicitly for a real deployment.
# APP_PUBLIC_URL=https://app.your-domain.example

# How long an invitation link stays valid.
INVITATION_TTL_DAYS=7
