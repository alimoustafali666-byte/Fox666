# The repository had no .gitignore at all, which meant backend/.env --
# holding the real database password and the JWT signing secret -- was
# one `git add -A` away from being committed. Secrets first:
.env
.env.*
!.env.example
.run/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Node / Next.js
node_modules/
.next/
# Throwaway build dir used to verify a production build without
# clobbering the .next a running `next dev` is serving (NEXT_DIST_DIR).
.next-verify/
*.tsbuildinfo

# Editor / OS
.DS_Store

# Database dumps. These contain real customer data, credentials hashes and
# audit history in plaintext -- they must never enter git history, where
# they would survive every later deletion. Keep them out of the repo
# entirely for anything beyond a throwaway local snapshot.
.backups/
*.dump
